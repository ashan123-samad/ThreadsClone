EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 1. Go to https://supabase.com/dashboard
# 2. Open your project → Project Settings → API
# 3. Copy "Project URL" into EXPO_PUBLIC_SUPABASE_URL (no trailing slash)
# 4. Copy "anon public" key into EXPO_PUBLIC_SUPABASE_ANON_KEY
# 5. Save this file, stop Expo (Ctrl+C), run: npm run start:clear
#
# Example (replace with your values):
# EXPO_PUBLIC_SUPABASE_URL=https://abcdefgh.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
